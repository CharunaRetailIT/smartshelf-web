# Copy to e2e/.env and fill in. e2e/.env is gitignored - never commit it.
E2E_EMPLOYEE_ID=your-employee-id
E2E_PASSWORD=your-password

# Optional overrides (defaults shown)
# E2E_BASE_URL=http://localhost:4200
# E2E_API_URL=https://localhost:44321/api
# E2E_DEVICE_MAC=e0000000be65
# E2E_TEMPLATE=Dynamic-4.2
# E2E_MESSAGE=Apple New

# Store to test against. Defaults to the store with the most devices.
# E2E_STORE_ID=2
